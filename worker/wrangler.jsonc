{
  "name": "obot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://api.linkos.in",
    "GOOGLE_CLIENT_ID": "4924083673-keao38oe65lth768v8r0d2lb76s06cuc.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obot-db",
      "database_id": "bd29e8f1-d971-4d76-9504-b24a99a344d2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d967999589704b42bbdd1e6cd6a1fce0"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ChatAgent", "class_name": "ChatAgent" },
      { "name": "McpAgent", "class_name": "McpAgent" }
    ]
  },
  "exports": {
    "ChatAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "McpAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
