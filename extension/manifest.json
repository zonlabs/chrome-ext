{
  "manifest_version": 3,
  "key": "",
  "name": "Obot",
  "version": "0.1.6",
  "description": "Your AI assistant",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "identity",
    "scripting"
  ],
  "oauth2": {
    "client_id": "4924083673-keao38oe65lth768v8r0d2lb76s06cuc.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/index.html"
  },
  "action": {
    "default_title": "Obot",
    "default_icon": {
      "16": "ui/assets/icons/icon16.png",
      "48": "ui/assets/icons/icon48.png",
      "128": "ui/assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "ui/assets/icons/icon16.png",
    "48": "ui/assets/icons/icon48.png",
    "128": "ui/assets/icons/icon128.png"
  }
}
